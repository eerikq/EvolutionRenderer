[
  {
    "label": "xmake: run Evolution Renderer",
    "command": "xmake",
    "args": ["run", "evolution_renderer"],
  },
  {
    "label": "xmake: build Evolution Renderer",
    "command": "xmake",
    "args": ["build", "evolution_renderer"],
  },
  {
    "label": "slang: compile shaders",
    "command": "slangc",
    "args": [
      "shaders/shader.slang",
      "-target",
      "spirv",
      "-profile",
      "spirv_1_4",
      "-emit-spirv-directly",
      "-fvk-use-entrypoint-name",
      "-entry",
      "vertMain",
      "-entry",
      "fragMain",
      "-o",
      "shaders/compiled/slang.spv",
    ],
  },
]
